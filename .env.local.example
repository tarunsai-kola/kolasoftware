# ============================================================
# .env.local.example
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://plnjtsnvbdjezulzfoms.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_aUbj3qbYfbUeQ9-czRMIQQ_6p5YELbY

# Server-only — NEVER expose to the browser (no NEXT_PUBLIC_ prefix)
# Used only in server components, API routes, and middleware
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Razorpay ─────────────────────────────────────────────────
# Found in: Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret-here

# Webhook signing secret — from Razorpay Dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret-here

# Per-order platform fee in paise (100 paise = ₹1). Default 0 for flat subscription model.
PLATFORM_FEE_PAISE=0

# ── Resend (Email) ───────────────────────────────────────────
# Found in: resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Verified sender address in your Resend account
RESEND_FROM_EMAIL=orders@yourplatform.com

# ── Platform Configuration ───────────────────────────────────
# The hostname of the super-admin portal.
# Requests to this domain are routed to the /(super-admin) layout.
PLATFORM_ADMIN_DOMAIN=admin.yourplatform.com
